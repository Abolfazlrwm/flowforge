# Django
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=flowforge.settings.dev

# Database
DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge

# Cache / Broker
REDIS_URL=redis://localhost:6379/0
# Default vhost is `/`, written as a single trailing slash. `//` parses as an
# empty vhost in pika and RabbitMQ rejects it with "vhost not found".
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Security (production overrides)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
